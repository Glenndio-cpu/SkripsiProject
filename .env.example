# Gemini AI Configuration
# Dapatkan API key gratis dari https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# EmailJS Configuration
# Dapatkan credentials dari https://www.emailjs.com/

# Service ID dari EmailJS (contoh: service_abc123)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Template ID untuk notifikasi konsultasi
VITE_EMAILJS_TEMPLATE_CONSULTATION=your_template_id_here

# Template ID untuk pesan kontak
VITE_EMAILJS_TEMPLATE_CONTACT=your_template_id_here

# Public Key dari EmailJS account
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# CARA SETUP:
# 1. Copy file ini menjadi .env (tanpa .example)
# 2. Isi dengan credentials Anda:
#    - Gemini API Key dari Google AI Studio
#    - EmailJS credentials dari dashboard EmailJS
# 3. Restart dev server setelah mengubah .env
# 4. Jangan commit file .env ke git!
